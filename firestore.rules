rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['PATIENT', 'DOCTOR']
        && request.resource.data.keys().hasOnly([
          'id', 'firstName', 'lastName', 'email', 'role', 'specialty',
          'address', 'phoneNumber', 'createdAt'
        ]);
      allow get: if signedIn()
        && (resource.data.role == 'DOCTOR' || resource.id == request.auth.uid);
      allow list: if signedIn() && resource.data.role == 'DOCTOR';
      allow update, delete: if false;
    }

    match /availability/{doctorId}/slots/{slotId} {
      allow get: if signedIn()
        && (request.auth.uid == doctorId || resource.data.status == 'OPEN');
      allow list: if signedIn() && request.auth.uid == doctorId;
      allow list: if signedIn() && resource.data.status == 'OPEN';
      allow create: if signedIn()
        && request.auth.uid == doctorId
        && get(/databases/$(database)/documents/users/$(doctorId)).data.role == 'DOCTOR'
        && request.resource.data.id == slotId
        && slotId == request.resource.data.date + '-' + request.resource.data.time
        && request.resource.data.doctorId == doctorId
        && request.resource.data.status == 'OPEN'
        && request.resource.data.keys().hasOnly([
          'id', 'doctorId', 'date', 'time', 'status', 'createdAt'
        ]);
      allow update: if signedIn()
        && request.auth.uid != doctorId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PATIENT'
        && resource.data.status == 'OPEN'
        && request.resource.data.status == 'BOOKED'
        && request.resource.data.doctorId == doctorId
        && request.resource.data.id == resource.data.id
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.patientName is string
        && request.resource.data.bookedAt is timestamp
        && request.resource.data.keys().hasAll([
          'patientId', 'patientName', 'bookedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'patientId', 'patientName', 'bookedAt'])
        && getAfter(
          /databases/$(database)/documents/appointments/$(doctorId + '_' + resource.data.date + '_' + resource.data.time)
        ).data.patientId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/appointments/$(doctorId + '_' + resource.data.date + '_' + resource.data.time)
        ).data.doctorId == doctorId
        && getAfter(
          /databases/$(database)/documents/appointments/$(doctorId + '_' + resource.data.date + '_' + resource.data.time)
        ).data.date == resource.data.date
        && getAfter(
          /databases/$(database)/documents/appointments/$(doctorId + '_' + resource.data.date + '_' + resource.data.time)
        ).data.time == resource.data.time
        && getAfter(
          /databases/$(database)/documents/appointments/$(doctorId + '_' + resource.data.date + '_' + resource.data.time)
        ).data.availabilityId == slotId;
      allow delete: if signedIn()
        && request.auth.uid == doctorId
        && resource.data.status == 'OPEN';
    }

    match /appointments/{appointmentId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/appointments/$(appointmentId))
          || resource.data.patientId == request.auth.uid
          || resource.data.doctorId == request.auth.uid
        );
      allow list: if signedIn() && resource.data.patientId == request.auth.uid;
      allow list: if signedIn() && resource.data.doctorId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasOnly([
          'patientId', 'patientName', 'doctorId', 'doctorName', 'specialty',
          'date', 'time', 'status', 'availabilityId', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'patientId', 'patientName', 'doctorId', 'doctorName', 'specialty',
          'date', 'time', 'status', 'availabilityId', 'createdAt'
        ])
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'PATIENT'
        && get(/databases/$(database)/documents/users/$(request.resource.data.doctorId))
          .data.role == 'DOCTOR'
        && appointmentId == request.resource.data.doctorId
          + '_' + request.resource.data.date + '_' + request.resource.data.time
        && getAfter(
          /databases/$(database)/documents/availability/$(request.resource.data.doctorId)/slots/$(request.resource.data.availabilityId)
        ).data.status == 'BOOKED'
        && getAfter(
          /databases/$(database)/documents/availability/$(request.resource.data.doctorId)/slots/$(request.resource.data.availabilityId)
        ).data.patientId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/availability/$(request.resource.data.doctorId)/slots/$(request.resource.data.availabilityId)
        ).data.doctorId == request.resource.data.doctorId
        && getAfter(
          /databases/$(database)/documents/availability/$(request.resource.data.doctorId)/slots/$(request.resource.data.availabilityId)
        ).data.date == request.resource.data.date
        && getAfter(
          /databases/$(database)/documents/availability/$(request.resource.data.doctorId)/slots/$(request.resource.data.availabilityId)
        ).data.time == request.resource.data.time;
      allow update, delete: if false;
    }
  }
}
